{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "emitDeclarationOnly": false,
    "module": "Node16",
    "target": "ES2022",
    "moduleResolution": "Node16",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/__tests__/**/*",
    "examples/**/*",
    "scripts/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "src/multistore/**/*",
    "src/crdt/**/*",
    "src/drizzle/**/*",
    "src/sync/git-sync.ts",
    "src/leader-election.ts",
    "src/react/simple-hooks.tsx",
    "src/simple.ts"
  ]
} 